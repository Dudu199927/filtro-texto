<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnElegir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Elegir archivo" />

        <TextView
            android:id="@+id/tvArchivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ningún archivo seleccionado"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="2. Palabras a buscar (separadas por coma)"
            android:inputType="textNoSuggestions|textMultiLine"
            android:minLines="1"
            android:maxLines="4" />

        <RadioGroup
            android:id="@+id/rgModo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbCualquiera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="La línea tiene cualquiera de las palabras" />

            <RadioButton
                android:id="@+id/rbTodas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="La línea tiene todas las palabras" />
        </RadioGroup>

        <EditText
            android:id="@+id/etExcluir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Palabras a excluir (opcional, separadas por coma)"
            android:inputType="textNoSuggestions|textMultiLine"
            android:minLines="1"
            android:maxLines="3" />

        <CheckBox
            android:id="@+id/cbMayus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Distinguir mayúsculas y minúsculas" />

        <CheckBox
            android:id="@+id/cbLatin1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Archivo en Latin-1 (si ves símbolos raros)" />

        <Button
            android:id="@+id/btnBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="3. Buscar" />

        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/barra"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:max="1000"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/llAcciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Guardar .txt" />

            <Button
                android:id="@+id/btnDescartar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Descartar" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCopiar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Copiar vista previa"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPreviaTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPrevia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#EEEEEE"
            android:padding="8dp"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:typeface="monospace"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
